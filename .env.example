# Kalshi live data is ON by default. Set to false to switch it off without a code change.
KALSHI_ENABLED=true
# Optional tuning (defaults shown)
KALSHI_REFRESH_SECONDS=180
# all = every category; or a comma-separated list such as Economics,Politics
KALSHI_CATEGORIES=all
# KALSHI_API_BASE=https://external-api.kalshi.com/trade-api/v2
POLYMARKET_ENABLED=false
