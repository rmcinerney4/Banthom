# Kalshi live data is ON by default. Set to false to switch it off without a code change.
KALSHI_ENABLED=true
# Optional tuning (defaults shown)
KALSHI_REFRESH_SECONDS=180
# all = every category; or a comma-separated list such as Economics,Politics
KALSHI_CATEGORIES=all
# KALSHI_API_BASE=https://external-api.kalshi.com/trade-api/v2
# Polymarket live data is ON by default.
POLYMARKET_ENABLED=true
POLYMARKET_REFRESH_SECONDS=180
# Suggested Kalshi–Polymarket pairs compare markets with at least this much traded in 24 hours (US dollars).
PAIRS_MIN_USD=100
# Pair review: password for the hidden review page (#app-review). Leave unset to switch review off.
# REVIEW_KEY=choose-a-long-password
# Where review decisions are saved. In production this points at a Railway volume.
# REVIEWS_FILE=/data/reviews.json
